{
  "name": "@swipeline/store-memory",
  "version": "0.3.0",
  "description": "In-memory Swipeline stores for tests, SSR and small demos.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./conformance": {
      "import": {
        "types": "./dist/conformance.d.ts",
        "default": "./dist/conformance.js"
      },
      "require": {
        "types": "./dist/conformance.d.cts",
        "default": "./dist/conformance.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/conformance.ts --format esm,cjs --sourcemap --clean && tsc -p tsconfig.build.json && node -e \"const fs=require('node:fs');for (const f of ['index','conformance']) fs.copyFileSync('dist/'+f+'.d.ts', 'dist/'+f+'.d.cts')\"",
    "dev": "tsup src/index.ts --format esm,cjs --sourcemap --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@swipeline/core": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "@swipeline/store-indexeddb": "workspace:*"
  },
  "keywords": [
    "swipe",
    "event-store",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoeyHammoth/Swipeline.git",
    "directory": "packages/store-memory"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "vitest": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "typesVersions": {
    "*": {
      "conformance": [
        "./dist/conformance.d.ts"
      ]
    }
  }
}
