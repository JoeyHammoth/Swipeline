{
  "name": "@swipeline/cli",
  "version": "0.3.0",
  "description": "The swipeline command: serve the HTTP API, validate, export and import a history, run the benchmark.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "swipeline": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm,cjs --sourcemap --clean && tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('dist/index.d.ts','dist/index.d.cts')\"",
    "dev": "tsup src/index.ts src/cli.ts --format esm,cjs --sourcemap --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@swipeline/adapter-http-json": "workspace:*",
    "@swipeline/bench": "workspace:*",
    "@swipeline/core": "workspace:*",
    "@swipeline/server": "workspace:*",
    "@swipeline/store-sqlite": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "keywords": [
    "swipe",
    "cli",
    "deck",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoeyHammoth/Swipeline.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
