{
  "name": "@swipeline/core",
  "version": "0.4.0",
  "description": "Schemas, types, config and the headless deck engine for Swipeline.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --sourcemap --clean && tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('dist/index.d.ts','dist/index.d.cts')\"",
    "dev": "tsup src/index.ts --format esm,cjs --sourcemap --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "schemas:export": "node scripts/export-schemas.mjs"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "fast-check": "^4.11.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "keywords": [
    "swipe",
    "deck",
    "recommendation",
    "local-first",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoeyHammoth/Swipeline.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
