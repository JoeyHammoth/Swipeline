{
  "name": "@swipeline/svelte",
  "version": "0.4.0",
  "description": "Svelte 5 binding for Swipeline decks: SwipeDeck, keyboard and live regions.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "svelte": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "dev": "svelte-package -i src -o dist --watch",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@swipeline/cards": "workspace:*",
    "@swipeline/core": "workspace:*",
    "@swipeline/gestures": "workspace:*",
    "@swipeline/i18n": "workspace:*"
  },
  "peerDependencies": {
    "svelte": ">=5.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.3",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "keywords": [
    "swipe",
    "svelte",
    "deck",
    "accessibility"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoeyHammoth/Swipeline.git",
    "directory": "packages/svelte"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
