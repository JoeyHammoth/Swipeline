{
  "name": "create-swipeline",
  "version": "0.4.0",
  "description": "Scaffold a Swipeline deck: blank, books, papers, recipes or products.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "create-swipeline": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm,cjs --sourcemap --clean && tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('dist/index.d.ts','dist/index.d.cts')\"",
    "dev": "tsup src/index.ts src/cli.ts --format esm,cjs --sourcemap --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "keywords": [
    "swipe",
    "scaffold",
    "create",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoeyHammoth/Swipeline.git",
    "directory": "packages/create-swipeline"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
