{
  "name": "@swipeline/react-native",
  "version": "0.4.1",
  "description": "React Native and Expo binding for Swipeline decks: SwipeDeck, action buttons and swipe announcements.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "react-native": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --sourcemap --clean && tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('dist/index.d.ts','dist/index.d.cts')\"",
    "dev": "tsup src/index.tsx --format esm,cjs --sourcemap --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@swipeline/cards": "workspace:*",
    "@swipeline/core": "workspace:*",
    "@swipeline/gestures": "workspace:*",
    "@swipeline/i18n": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.76"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "react": "^19.3.1",
    "react-native": "^0.88.1",
    "react-test-renderer": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "keywords": [
    "swipe",
    "react-native",
    "expo",
    "deck",
    "accessibility"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoeyHammoth/Swipeline.git",
    "directory": "packages/react-native"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
