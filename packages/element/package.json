{
  "name": "@swipeline/element",
  "version": "0.3.0",
  "description": "Web Component binding for Swipeline decks: <swipe-deck>, DOM events and CSS parts.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --sourcemap --clean && tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('dist/index.d.ts','dist/index.d.cts')\"",
    "dev": "tsup src/index.ts --format esm,cjs --sourcemap --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@swipeline/cards": "workspace:*",
    "@swipeline/core": "workspace:*",
    "@swipeline/gestures": "workspace:*",
    "@swipeline/i18n": "workspace:*",
    "@swipeline/theme": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "keywords": [
    "swipe",
    "web-component",
    "custom-element",
    "deck"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoeyHammoth/Swipeline.git",
    "directory": "packages/element"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
