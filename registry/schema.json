{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swipeline.dev/schemas/registry.schema.json",
  "title": "Swipeline adapter registry",
  "type": "object",
  "required": ["version", "adapters"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date" },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "package", "description", "source", "license", "maintainers"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "package": { "type": "string", "pattern": "^(@[a-z0-9-]+/)?[a-z0-9][a-z0-9-]*$" },
          "description": { "type": "string", "maxLength": 200 },
          "source": { "type": "string", "format": "uri" },
          "repo": { "type": "string", "format": "uri" },
          "license": { "type": "string" },
          "maintainers": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "attributionRequired": { "type": "boolean" },
          "rateLimitNotes": { "type": "string" },
          "termsUrl": { "type": "string", "format": "uri" },
          "conformance": { "enum": ["passing", "unknown"] }
        }
      }
    }
  }
}
