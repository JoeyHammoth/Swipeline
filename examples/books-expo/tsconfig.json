{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@swipeline/cards": ["../../packages/cards/src/index.ts"],
      "@swipeline/core": ["../../packages/core/src/index.ts"],
      "@swipeline/gestures": ["../../packages/gestures/src/index.ts"],
      "@swipeline/i18n": ["../../packages/i18n/src/index.ts"],
      "@swipeline/react-native": ["../../packages/react-native/src/index.tsx"],
      "@swipeline/store-memory": ["../../packages/store-memory/src/index.ts"]
    }
  },
  "include": ["index.ts", "src/**/*.ts", "src/**/*.tsx", "test/**/*.ts"]
}
