{
  "$id": "https://swipeline.dev/schemas/profile.schema.json",
  "title": "Swipeline Profile",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "deckId": {
      "type": "string",
      "minLength": 1
    },
    "prefVector": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "tagStats": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "a": {
            "type": "number",
            "minimum": 0
          },
          "b": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "a",
          "b"
        ],
        "additionalProperties": false
      }
    },
    "counts": {
      "type": "object",
      "properties": {
        "seen": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "liked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "disliked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "seen",
        "liked",
        "disliked"
      ],
      "additionalProperties": false
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "actor",
    "deckId",
    "tagStats",
    "counts",
    "updatedAt"
  ],
  "additionalProperties": false
}
